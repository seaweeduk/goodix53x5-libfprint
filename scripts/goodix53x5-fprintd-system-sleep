#!/bin/sh
# Keep Goodix 53x5/fprintd out of S4 without breaking ordinary suspend.

set -eu

phase="${1:-}"
mode="${2:-}"
action="${SYSTEMD_SLEEP_ACTION:-}"

if [ -z "$action" ]; then
  case "$mode" in
    hibernate|hybrid-sleep)
      action="$mode"
      ;;
    suspend-then-hibernate)
      # Without SYSTEMD_SLEEP_ACTION we cannot distinguish the initial suspend
      # phase from the later hibernate phase, and stopping fprintd before the
      # initial suspend breaks active lockscreen fingerprint prompts.
      echo "goodix53x5-fprintd-system-sleep: SYSTEMD_SLEEP_ACTION unavailable, leaving suspend-then-hibernate unchanged"
      exit 0
      ;;
    *)
      exit 0
      ;;
  esac
fi

case "$action" in
  hibernate|hybrid-sleep)
    ;;
  *)
    # Do not stop fprintd for ordinary suspend or for the initial suspend
    # phase of suspend-then-hibernate. Killing an active lockscreen PAM
    # transaction there leaves hyprlock showing a dead fingerprint prompt.
    exit 0
    ;;
esac

case "$phase" in
  pre)
    echo "goodix53x5-fprintd-system-sleep: stopping fprintd before $action"
    systemctl stop fprintd.service || true
    ;;
  post)
    echo "goodix53x5-fprintd-system-sleep: recovering Goodix before releasing users after $action"
    /usr/local/libexec/goodix53x5-fprintd-recover || true
    ;;
esac

#!/usr/bin/env bash
set -euo pipefail

output=
while (( $# )); do
  case "$1" in
    --output) output=${2-}; shift 2 ;;
    *) printf 'usage: %s --output PATH\n' "$0" >&2; exit 2 ;;
  esac
done
if [[ -z $output ]]; then
  printf 'usage: %s --output PATH\n' "$0" >&2
  exit 2
fi

compiler=${CC:-x86_64-w64-mingw32-gcc}
if ! command -v "$compiler" >/dev/null 2>&1; then
  printf 'missing MinGW compiler: %s\n' "$compiler" >&2
  exit 2
fi

tool=$(dirname "$(realpath "$0")")
mkdir -p "$(dirname "$output")"
"$compiler" -std=c17 -O2 -Wall -Wextra -Werror -municode \
  -Wl,--no-insert-timestamp \
  "$tool/native/native-oracle.c" -o "$output"
